# syntax=docker/dockerfile:1

# Web anfitrión (Vite SPA) — build en el workspace pnpm, runtime en nginx.
# Build:  docker build -f Dockerfile.web-host -t mesa247-web-host .
# Contexto: raíz del repo (docker compose ya lo usa así) — pnpm necesita
# el workspace completo (packages/shared se consume como fuente TS, D56).

FROM node:24-alpine AS deps

# pnpm versión del root package.json (packageManager) — global y pinneado.
RUN npm install -g pnpm@11.7.0

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile

FROM deps AS build

# Vite embebe import.meta.env en el bundle: el origen del API es build-time.
# Default = el mismo del dev, así compose funciona sin args extra.
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm --filter web-host build

FROM nginx:stable-alpine AS runtime

COPY --from=build /app/apps/web-host/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80